# noto.yaml - PA Instance Configuration
# Copy this file to noto.yaml and customize for your instance.
# This file is git-ignored — it contains instance-specific settings.

agent:
  name: "MyAssistant"
  role: "Personal Assistant"

user:
  name: "Your Name"
  preferred_language: "English"
  native_language: "English"

# Paths (relative to NOTO_HOME, or absolute)
paths:
  credentials: "brain/credentials.yaml"
  emails_dir: "emails"
  indexes_dir: "indexes"
  memory_dir: "memory"
  brain_dir: "brain"
  venv: ".venv"

# Email configuration
email:
  accounts:
    # - address: "you@example.com"
    #   config_key: "you_example"
    #   imap_server: "imap.example.com"
    #   imap_port: 993
    #   smtp_server: "smtp.example.com"
    #   smtp_port: 465
  operator_emails: []
    # - "you@example.com"

# Memory system
memory:
  long_term_index: "indexes/memories.mv2"
  short_term_index: "indexes/short-term.mv2"
  metadata_db: "indexes/memory_meta.db"
  similarity_threshold: 0.85
  default_confidence: 0.7

# File index
files:
  index_path: "indexes/files.mv2"

# Security
security:
  integrity_checksum_file: "indexes/integrity-checksums.sha256"
  watched_files:
    - "CLAUDE.md"
    - "brain/*.md"

# LLM backend for BACKGROUND jobs only (nightly learning pass, transcript
# feedback extraction). Your interactive agent is whatever harness you run —
# Claude Code, Codex CLI, Gemini CLI, OpenCode, ... — noto never owns that loop.
# `auto` picks the first available: claude-cli, codex-cli, gemini-cli, then
# anthropic (ANTHROPIC_API_KEY) or openai (OPENAI_API_KEY).
llm:
  backend: "auto"        # auto | claude-cli | codex-cli | gemini-cli | anthropic | openai
  model: ""              # optional; empty = backend default (anthropic: claude-opus-5). Required for openai.
  base_url: ""           # openai backend: http://localhost:11434/v1 (Ollama), https://api.openai.com/v1,
                         #   https://openrouter.ai/api/v1, http://localhost:1234/v1 (LM Studio) ...
  api_key_env: ""        # env var holding the key; default ANTHROPIC_API_KEY / OPENAI_API_KEY (unset = no auth, fine for local)
  timeout_seconds: 180

# Learning loop (tools/learn.py) — feedback -> lessons -> operator approval -> standing instructions
learning:
  db: "indexes/learning.db"
  lessons_file: "brain/lessons.md"
  log_file: "brain/learning-log.md"
  skills_dir: "skills"
